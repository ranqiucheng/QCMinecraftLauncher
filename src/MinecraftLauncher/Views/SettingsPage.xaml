<UserControl x:Class="MinecraftLauncher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="游戏目录（.minecraft 文件夹）" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,18">
                        <Button Content="浏览..." DockPanel.Dock="Right" Width="84" Height="34" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="BrowseGameDir_Click"/>
                        <TextBox x:Name="GameDirBox" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                    </DockPanel>

                    <TextBlock Text="最大内存" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <ComboBox x:Name="MemoryCombo" Height="34" Margin="0,0,0,18" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="1 GB"/>
                        <ComboBoxItem Content="2 GB"/>
                        <ComboBoxItem Content="4 GB"/>
                        <ComboBoxItem Content="6 GB"/>
                        <ComboBoxItem Content="8 GB"/>
                        <ComboBoxItem Content="12 GB"/>
                        <ComboBoxItem Content="16 GB"/>
                    </ComboBox>

                    <TextBlock Text="Java 路径（留空则自动检测）" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,18">
                        <Button Content="浏览..." DockPanel.Dock="Right" Width="84" Height="34" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="BrowseJava_Click"/>
                        <TextBox x:Name="JavaBox" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="自动检测 Java" Height="30" Style="{StaticResource SecondaryButtonStyle}" Click="DetectJava_Click"/>
                    <ComboBox x:Name="DetectedJavaCombo" Width="340" Height="30" Margin="10,0,0,0" SelectionChanged="DetectedJava_SelectionChanged"/>
                </StackPanel>
                <TextBlock x:Name="JavaDetectStatus" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </DockPanel>

                    <TextBlock Text="下载源" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <ComboBox x:Name="SourceCombo" Height="34" Margin="0,0,0,18" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="官方源（Mojang）"/>
                        <ComboBoxItem Content="BMCLAPI 镜像（国内推荐）"/>
                    </ComboBox>

                    <TextBlock Text="界面主题" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <ComboBox x:Name="ThemeCombo" Height="34" Margin="0,0,0,18" VerticalContentAlignment="Center" SelectionChanged="ThemeChanged">
                        <ComboBoxItem Content="深色（默认）"/>
                        <ComboBoxItem Content="浅色"/>
                    </ComboBox>
                    <TextBlock Text="主题色" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <ComboBox x:Name="ColorCombo" Height="34" Margin="0,0,0,18" VerticalContentAlignment="Center" SelectionChanged="ThemeChanged">
                        <ComboBoxItem Content="紫色（默认）"/>
                        <ComboBoxItem Content="蓝色"/>
                        <ComboBoxItem Content="绿色"/>
                        <ComboBoxItem Content="红色"/>
                        <ComboBoxItem Content="橙色"/>
                        <ComboBoxItem Content="青色"/>
                        <ComboBoxItem Content="粉色"/>
                    </ComboBox>
                    <CheckBox x:Name="IsolationCheck" Content="版本隔离（每个版本独立 mods/存档/资源包目录，推荐开启）" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <CheckBox x:Name="CloseAfterLaunchCheck" Content="启动游戏后关闭启动器" Margin="0,0,0,20" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <Button x:Name="SaveButton" Content="保存设置" Width="150" Height="40"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
