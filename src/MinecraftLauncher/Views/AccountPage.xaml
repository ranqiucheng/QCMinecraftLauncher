<UserControl x:Class="MinecraftLauncher.Views.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="账号" Style="{StaticResource PageTitleStyle}"/>

            <!-- 当前账号 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="当前账号" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="CurrentAccountText" Text="未登录" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="CurrentAccountType" Text="" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 离线登录 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="离线登录" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <DockPanel>
                        <Button Content="设为离线账号" DockPanel.Dock="Right" Width="124" Height="36"
                                Style="{StaticResource PrimaryButtonStyle}" Click="OfflineButton_Click"/>
                        <TextBox x:Name="OfflineNameBox" Height="36" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                 Padding="10,0" FontSize="14"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Microsoft 正版登录 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Microsoft 正版登录" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="点击后会自动打开浏览器，登录你的 Microsoft 账号即可完成验证。"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14"/>
                    <TextBlock Text="点击后会打开浏览器，登录 Microsoft 账号后页面会显示一个 code，复制粘贴回启动器即可（无需注册 Azure 应用）。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="MsLoginButton" Content="开始正版登录" Width="170" Height="40"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="MsLoginButton_Click"/>
                    <TextBlock x:Name="MsStatusText" TextWrapping="Wrap" Margin="0,14,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>