<UserControl x:Class="MinecraftLauncher.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：文件夹 -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="文件夹列表" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="FolderName" Text=".minecraft" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="FolderPath" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="切换游戏文件夹..." Height="36" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="SwitchFolder_Click"/>
                <Button Content="刷新版本列表" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click"/>
            </StackPanel>
        </Border>

        <!-- 右侧：账号 + 版本卡片 + 日志 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <!-- 账号卡片 -->
            <Border Grid.Row="0" Style="{StaticResource ClickableCardStyle}" MouseLeftButtonDown="AccountArea_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="M" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountText" Text="Player" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="AccountSubText" Text="离线模式（点击设置用户名）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 版本卡片列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="常规版本" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,10"/>
                    <ItemsControl x:Name="VersionItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ClickableCardStyle}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Image Source="{Binding IconImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Info}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="启动" Width="90" Height="38"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="LaunchItem_Click" Tag="{Binding}"/>
                                            <Button Content="删除" Width="60" Height="38" Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DeleteVersion_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyText" Text="还没有安装任何版本，请到「下载」页安装"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="4,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 日志 -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>