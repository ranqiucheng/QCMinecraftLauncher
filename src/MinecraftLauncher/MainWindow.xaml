<Window x:Class="MinecraftLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QCmcl" Icon="Assets/app.ico" Height="780" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏（白色） -->
        <Border Grid.Column="0" Background="White" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,26,0,20">
                    <Image Source="Assets/app.png" Width="80" Height="80" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="QCmcl" Foreground="{DynamicResource PrimaryBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="Minecraft 启动器" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         FontSize="15" ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="启动"/>
                    <ListBoxItem Content="下载"/>
                    <ListBoxItem Content="账号"/>
                    <ListBoxItem Content="Mod 管理"/>
                    <ListBoxItem Content="皮肤"/>
                    <ListBoxItem Content="设置"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="ContentHost"/>
            <!-- 浮动下载进度（可拖动，点击看详情） -->
            <Border x:Name="DownloadBadge" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,20"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Visibility="Collapsed" Cursor="Hand"
                    MouseLeftButtonDown="DownloadBadge_MouseDown" MouseMove="DownloadBadge_MouseMove" MouseLeftButtonUp="DownloadBadge_MouseUp">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="DownloadCancelBtn" Content="✕" DockPanel.Dock="Right" Width="20" Height="20" FontSize="11"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                                Cursor="Hand" Click="DownloadCancel_Click"/>
                        <TextBlock x:Name="DownloadBadgeTitle" Text="下载中" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DockPanel>
                    <ProgressBar x:Name="DownloadBadgeProgress" Width="240" Height="8" Minimum="0" Maximum="100"
                                 Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource HoverBackgroundBrush}" BorderThickness="0"/>
                    <TextBlock x:Name="DownloadBadgeStatus" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="240"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>